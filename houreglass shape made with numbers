#include <iostream>
using namespace std;

int main() 
{
    for(int i=1; i<=5; i++){
        for(int j=1; j<=i; j++)
        cout<<" ";
        for(int k=5; k>=i-1; k--)
        cout<<7-i<<" ";
    cout<<endl;
